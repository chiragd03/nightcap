<?xml version="1.0" encoding="utf-8"?>
<!-- A settings card: clear frosted glass, brighter with a light edge when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="180" android:exitFadeDuration="180">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="#3DFFFFFF" android:endColor="#22FFFFFF" />
            <stroke android:width="1.2dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="#17FFFFFF" android:endColor="#0BFFFFFF" />
            <stroke android:width="0.8dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
