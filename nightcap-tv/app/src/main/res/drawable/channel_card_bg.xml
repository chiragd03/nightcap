<?xml version="1.0" encoding="utf-8"?>
<!-- A channel tile: dark glass with a faint edge; a bright ring when focused (or picked in the player's strip). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="270" android:startColor="#1AFFFFFF" android:endColor="#0DFFFFFF" />
            <stroke android:width="1.2dp" android:color="#D9FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="270" android:startColor="#1AFFFFFF" android:endColor="#0DFFFFFF" />
            <stroke android:width="1.2dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient android:angle="270" android:startColor="#16FFFFFF" android:endColor="#09FFFFFF" />
            <stroke android:width="0.8dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
