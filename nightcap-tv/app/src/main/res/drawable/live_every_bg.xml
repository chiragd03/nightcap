<?xml version="1.0" encoding="utf-8"?>
<!-- Search every channel's panel: dark glass with a faint edge; a bright edge when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="0" android:startColor="#2E2A2414" android:endColor="#14FFFFFF" />
            <stroke android:width="1.2dp" android:color="#D9FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="0" android:startColor="#1A1A2232" android:endColor="#0DFFFFFF" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
</selector>
