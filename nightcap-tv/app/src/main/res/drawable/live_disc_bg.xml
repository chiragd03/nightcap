<?xml version="1.0" encoding="utf-8"?>
<!-- The live player's buttons: dark glass discs like Home's sound button, with a soft light from the
     top; solid white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#F7FFFFFF" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#99101624" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#29FFFFFF" android:endColor="#00FFFFFF" />
                    <stroke android:width="1dp" android:color="#38FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
