<?xml version="1.0" encoding="utf-8"?>
<!-- The "Leave this household" tile: a settings card with a faint red tint (redder when focused). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="180" android:exitFadeDuration="180">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="#4DE0525A" android:endColor="#26E0525A" />
            <stroke android:width="1.2dp" android:color="#B3FFB3B8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="#26E0525A" android:endColor="#12E0525A" />
            <stroke android:width="0.8dp" android:color="#33FF8A90" />
        </shape>
    </item>
</selector>
