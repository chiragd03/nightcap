<?xml version="1.0" encoding="utf-8"?>
<!-- One letter of a join code: the search bar's quiet glass; the next one to type is outlined. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#F2252C3C" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#D9161C29" />
        </shape>
    </item>
</selector>
