<?xml version="1.0" encoding="utf-8"?>
<!-- The screen being left eases back and fades. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <scale android:fromXScale="1" android:fromYScale="1" android:pivotX="50%" android:pivotY="50%"
        android:toXScale="1.03" android:toYScale="1.03" />
</set>
