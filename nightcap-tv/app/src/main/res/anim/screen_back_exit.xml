<?xml version="1.0" encoding="utf-8"?>
<!-- Going back: the screen being closed shrinks a little and fades. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="260"
    android:interpolator="@android:interpolator/accelerate_cubic">
    <alpha android:fromAlpha="1" android:toAlpha="0" />
    <scale android:fromXScale="1" android:fromYScale="1" android:pivotX="50%" android:pivotY="50%"
        android:toXScale="0.965" android:toYScale="0.965" />
</set>
