<?xml version="1.0" encoding="utf-8"?>
<!-- Who's watching: the profiles in a row over a soft glow in the chosen avatar's colour. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <local.nightcap.AuraView
        android:id="@+id/aura"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/whoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/big_shoulders"
            android:fontVariationSettings="'wght' 700"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="Who's watching?"
            android:textColor="@color/text"
            android:textSize="34sp" />

        <LinearLayout
            android:id="@+id/people"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp" />

        <!-- Admin only: remove profiles (the button reads "Done" while managing). -->
        <TextView
            android:id="@+id/manage"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/nav_item_bg"
            android:focusable="true"
            android:fontVariationSettings="'wght' 600"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Manage profiles"
            android:textColor="@color/nav_item_fg"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- No profiles to show yet: loading, or the server couldn't be reached (with a way on). -->
        <TextView
            android:id="@+id/whoStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/whoActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/whoRetry"
                android:layout_width="wrap_content"
                android:text="Try again"
                android:layout_height="32dp"
                android:background="@drawable/nav_item_bg"
                android:focusable="true"
                android:fontVariationSettings="'wght' 600"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textColor="@color/nav_item_fg"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/whoChangeServer"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Change server"
                android:layout_height="32dp"
                android:background="@drawable/nav_item_bg"
                android:focusable="true"
                android:fontVariationSettings="'wght' 600"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:textColor="@color/nav_item_fg"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Adding a profile: pick an avatar, type a name. -->
    <FrameLayout
        android:id="@+id/adder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="70dp"
            android:fontFamily="@font/big_shoulders"
            android:fontVariationSettings="'wght' 700"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="Add profile"
            android:textColor="@color/text"
            android:textSize="30sp" />

        <local.nightcap.AvatarCarousel
            android:id="@+id/carousel"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_gravity="center"
            android:layout_marginBottom="70dp"
            android:clipChildren="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="130dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/adderAvatarName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/adderName"
                android:layout_width="300dp"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bar_bg"
                android:gravity="center"
                android:hint="Name"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="20"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/adderSave"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/nav_item_bg"
                android:focusable="true"
                android:fontVariationSettings="'wght' 600"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:text="Add"
                android:textColor="@color/nav_item_fg"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/whoHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="30dp"
        android:text="You can switch profiles any time from the menu"
        android:textColor="@color/muted"
        android:textSize="9sp" />
</FrameLayout>
