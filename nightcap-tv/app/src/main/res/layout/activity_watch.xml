<?xml version="1.0" encoding="utf-8"?>
<!-- The Nightcap player: VLC video, a loading card, and Apple TV-style controls over the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- While a stream is found and opened: the title's art, dimmed, its name and one calm line. Mid-film
         (a reconnect, a switch) the same over the picture, darkened, without the art. -->
    <FrameLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ink">

        <ImageView
            android:id="@+id/loadingArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.35"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_left" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="44dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/loadingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontVariationSettings="'wght' 700"
                android:maxWidth="520dp"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/loadingEpisode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/loadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontVariationSettings="'wght' 500"
                android:textColor="@color/text"
                android:textSize="10sp" />

        </LinearLayout>
    </FrameLayout>

    <!-- Controls: shown on any key, fade after a few seconds of playback. The title over a deep
         gradient, a rounded timeline, and glass buttons. -->
    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="invisible">

        <View
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_gravity="bottom"
            android:background="@drawable/player_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="56dp"
            android:paddingBottom="32dp">

            <!-- The show and episode number (films: hidden). -->
            <TextView
                android:id="@+id/eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontVariationSettings="'wght' 700"
                android:letterSpacing="0.16"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="8.5sp" />

            <!-- The episode's name, or the film's. -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/big_shoulders"
                android:fontVariationSettings="'wght' 700"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="30sp" />

            <!-- The source playing: quality, HDR, release. -->
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/muted"
                android:textSize="9sp" />

            <!-- The round play/pause button, centred on the timeline beside it. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <ImageView
                android:id="@+id/playPause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/player_play_button"
                android:contentDescription="Pause"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:padding="12dp"
                android:src="@drawable/ic_pl_pause" />

            <!-- The timeline: focusable so Left/Right scrub and OK pauses. -->
            <FrameLayout
                android:id="@+id/timeline"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <View
                    android:id="@+id/track"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/player_track" />

                <View
                    android:id="@+id/fill"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/player_fill"
                    android:scaleX="0"
                    android:transformPivotX="0dp" />

                <View
                    android:id="@+id/knob"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:alpha="0"
                    android:background="@drawable/player_knob" />
            </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_marginTop="0dp">

                <TextView
                    android:id="@+id/elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:fontVariationSettings="'wght' 600"
                    android:textColor="@color/text"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/endsAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:fontFeatureSettings="tnum"
                    android:fontVariationSettings="'wght' 600"
                    android:textColor="@color/text"
                    android:textSize="9.5sp" />
            </FrameLayout>

            <!-- The buttons: settings on the left; for episodes, the season and the next one on the right. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/chips"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipAudio"
                        style="@style/PlayerChip.Icon"
                        android:drawableStart="@drawable/ic_pl_audio"
                        android:text="Audio" />

                    <TextView
                        android:id="@+id/chipSubtitles"
                        style="@style/PlayerChip.Icon"
                        android:drawableStart="@drawable/ic_pl_subtitles"
                        android:text="Subtitles" />

                    <TextView
                        android:id="@+id/chipQuality"
                        style="@style/PlayerChip.Icon"
                        android:drawableStart="@drawable/ic_pl_quality"
                        android:text="Quality" />

                    <TextView
                        android:id="@+id/chipPicture"
                        style="@style/PlayerChip.Icon"
                        android:drawableStart="@drawable/ic_pl_picture"
                        android:text="Picture" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chipEpisodes"
                    style="@style/PlayerChip.Icon"
                    android:drawableStart="@drawable/ic_pl_episodes"
                    android:text="Episodes"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chipNext"
                    style="@style/PlayerChip.Icon"
                    android:layout_marginEnd="0dp"
                    android:drawableStart="@drawable/ic_pl_next"
                    android:text="Next episode"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Up next: the following episode, near the end, with a countdown. -->
    <LinearLayout
        android:id="@+id/upNext"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/player_glass"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/upNextStill"
            android:layout_width="112dp"
            android:layout_height="63dp"
            android:background="@drawable/card_bg"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SearchLabel"
                android:text="UP NEXT" />

            <TextView
                android:id="@+id/upNextName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontVariationSettings="'wght' 600"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/upNextPlay"
                style="@style/PlayerChip"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Leaving early (asked once per title): centred over the paused, dimmed picture. -->
    <FrameLayout
        android:id="@+id/exitCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/sheet_tint"
            android:elevation="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/exitTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontVariationSettings="'wght' 700"
                android:maxLines="1"
                android:maxWidth="320dp"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/exitChoices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/exitHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Back to leave without answering"
                android:textColor="@color/muted"
                android:textSize="8.5sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Rating at the end (asked once per title): in the middle over a soft dimming, playback carries on. -->
    <FrameLayout
        android:id="@+id/rateCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rate_scrim" />

        <LinearLayout
            android:id="@+id/rateBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/player_glass"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="16dp"
            android:gravity="center_horizontal"
            android:minWidth="400dp"
            android:orientation="vertical"
            android:paddingHorizontal="36dp"
            android:paddingTop="26dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontVariationSettings="'wght' 700"
                android:letterSpacing="0.16"
                android:text="How was it?"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/rateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/big_shoulders"
                android:fontVariationSettings="'wght' 800"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="460dp"
                android:textAllCaps="true"
                android:textColor="@color/text"
                android:textSize="30sp" />

            <LinearLayout
                android:id="@+id/rateChoices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </LinearLayout>
    </FrameLayout>

    <!-- Mid-film, while it waits for the file (or for audio just switched to): a small spinner. -->
    <ProgressBar
        android:id="@+id/buffering"
        style="?android:attr/progressBarStyle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/text"
        android:visibility="gone" />

    <!-- A short note in the corner: "Subtitles +0.3 s", "Paused", "Resumed at 18:56". -->
    <TextView
        android:id="@+id/note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="28dp"
        android:alpha="0"
        android:background="@drawable/player_glass"
        android:fontVariationSettings="'wght' 500"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/text"
        android:textSize="10sp" />

    <!-- Audio, subtitle, source and picture choices: a glass card on the right. -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginEnd="24dp"
        android:layout_marginVertical="28dp"
        android:background="@drawable/player_glass"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/panelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/big_shoulders"
            android:fontVariationSettings="'wght' 700"
            android:includeFontPadding="false"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <ScrollView
            android:id="@+id/panelScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/panelItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
