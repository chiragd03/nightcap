<?xml version="1.0" encoding="utf-8"?>
<!-- One choice on the player's one-time cards: icon over label, a white pill when focused. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:background="@drawable/nav_item_bg"
    android:focusable="true"
    android:gravity="center"
    android:minWidth="92dp"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="9dp">

    <ImageView
        android:id="@+id/choiceIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:tint="@color/nav_item_fg" />

    <TextView
        android:id="@+id/choiceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:duplicateParentState="true"
        android:fontVariationSettings="'wght' 500"
        android:maxLines="1"
        android:textColor="@color/nav_item_fg"
        android:textSize="10sp" />
</LinearLayout>
