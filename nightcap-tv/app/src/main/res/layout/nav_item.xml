<?xml version="1.0" encoding="utf-8"?>
<!-- One side-panel entry: a thin line icon and its label, dark on the white focus pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginVertical="2dp"
    android:background="@drawable/nav_item_bg"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <ImageView
        android:id="@+id/navIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:tint="@color/nav_item_fg" />

    <TextView
        android:id="@+id/navLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontVariationSettings="'wght' 500"
        android:maxLines="1"
        android:textColor="@color/nav_item_fg"
        android:textSize="14sp" />
</LinearLayout>
