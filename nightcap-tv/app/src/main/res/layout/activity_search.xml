<?xml version="1.0" encoding="utf-8"?>
<!-- Search: a wide bar on top; under it either suggestions (empty) or the focused
     result's backdrop and details, then result rows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="670dp"
        android:layout_height="377dp"
        android:layout_gravity="top|end">

        <ImageView
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextureView
            android:id="@+id/trailer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_left" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_bottom" />
    </FrameLayout>

    <!-- Search bar with the Smart Search button inside it. -->
    <FrameLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="24dp">

        <EditText
            android:id="@+id/query"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bar_bg"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:hint="Search films, series and people"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="18dp"
            android:paddingEnd="120dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/askAi"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="6dp"
            android:background="@drawable/ask_pill"
            android:focusable="true"
            android:fontVariationSettings="'wght' 700"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="✦  Smart Search"
            android:textColor="@color/chip_fg"
            android:textSize="13sp"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- Empty state: recent searches and Smart Search ideas. -->
    <LinearLayout
        android:id="@+id/suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="92dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recentLabel"
            style="@style/SearchLabel"
            android:text="RECENT SEARCHES"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/recentChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/smartLabel"
            style="@style/SearchLabel"
            android:text="TRY A SMART SEARCH" />

        <LinearLayout
            android:id="@+id/suggestionRow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/suggestionRow2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Details of the focused result, like Home. -->
    <LinearLayout
        android:id="@+id/details"
        android:layout_width="480dp"
        android:layout_height="168dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="90dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontVariationSettings="'wght' 700"
            android:letterSpacing="0.16"
            android:textAllCaps="true"
            android:textColor="@color/lamp"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/big_shoulders"
            android:fontVariationSettings="'wght' 800"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:lineSpacingMultiplier="1.15"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="290dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="240dp" />

    <!-- Side menu, as on Home: Left on a row's first card opens it. -->
    <local.nightcap.NavRail
        android:id="@+id/navRail"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
