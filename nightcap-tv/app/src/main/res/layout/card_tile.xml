<?xml version="1.0" encoding="utf-8"?>
<!-- A Browse tile (a language, a genre, a chart): its top title's picture, darkened toward its lower
     left, with what kind of tile it is in small letters over its name in the display font. With no
     picture, a soft colour of its own. Focused, it lifts and light catches it, as the posters do. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="176dp"
    android:layout_height="99dp"
    android:layout_marginEnd="13dp"
    android:background="@drawable/card_bg"
    android:focusable="true">

    <ImageView
        android:id="@+id/tileArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tile_shade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tileKind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontVariationSettings="'wght' 700"
            android:letterSpacing="0.16"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textAllCaps="true"
            android:textColor="#B3DCE2EC"
            android:textSize="7.5sp" />

        <TextView
            android:id="@+id/tileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/big_shoulders"
            android:fontVariationSettings="'wght' 800"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowRadius="6"
            android:textAllCaps="true"
            android:textColor="@color/text"
            android:textSize="19sp" />
    </LinearLayout>

    <!-- Light catching the card when it's focused (see Motion.focus). -->
    <View
        android:id="@+id/sheen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/card_sheen" />
</FrameLayout>
