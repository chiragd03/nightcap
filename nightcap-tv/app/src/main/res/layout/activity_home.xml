<?xml version="1.0" encoding="utf-8"?>
<!-- 960x540dp canvas: info about the focused title on top, rows below it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:clipChildren="false">

    <!-- Backdrop of the focused title; its trailer fades in over it after a short rest. -->
    <FrameLayout
        android:layout_width="670dp"
        android:layout_height="377dp"
        android:layout_gravity="top|end">

        <ImageView
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextureView
            android:id="@+id/trailer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_left" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_bottom" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="460dp"
        android:layout_height="200dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="84dp"
        android:orientation="vertical">
        <!-- Fixed box between the clock and the rows: text starts under the clock and is
             clipped at the box edge, so it can never reach the rows. -->

        <TextView
            android:id="@+id/eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontVariationSettings="'wght' 700"
            android:letterSpacing="0.16"
            android:textAllCaps="true"
            android:textColor="@color/lamp"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/big_shoulders"
            android:fontVariationSettings="'wght' 800"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.9"
            android:maxLines="2"
            android:textAllCaps="true"
            android:textSize="50sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Tells you where you are, and that Left opens the side panel. -->
    <TextView
        android:id="@+id/navHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="46dp"
        android:layout_marginTop="12dp"
        android:fontVariationSettings="'wght' 600"
        android:letterSpacing="0.06"
        android:text="‹  Home"
        android:textColor="@color/muted"
        android:textSize="11sp" />

    <!-- Clock and date, top left, as in the prototype. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="28dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/big_shoulders"
            android:fontFeatureSettings="tnum"
            android:fontVariationSettings="'wght' 700"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:shadowColor="#B3000000"
            android:shadowRadius="8"
            android:textSize="40sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:shadowColor="#B3000000"
            android:shadowRadius="8"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Weather, top right over the backdrop. Hidden until the server answers. The trailer sound
         button sits to its left, and takes the corner when the weather is hidden. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/trailerSound"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/sound_button_bg"
            android:contentDescription="Trailer sound"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_sound_on"
            android:tint="@color/nav_item_fg" />

        <!-- Frosted glass: a blurred copy of the backdrop lined up under the box (see Glass.kt). -->
        <FrameLayout
            android:id="@+id/weatherWidget"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/glass_shape"
            android:clipToOutline="true"
            android:visibility="gone">

            <local.nightcap.GlassImageView
                android:id="@+id/weatherGlass"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="matrix" />

            <!-- Dark tint between the blur and the text, so the text always reads. -->
            <local.nightcap.GlassImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glass_tint" />

        <!-- Icon | temperature + feels like, then city · conditions · high/low. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="11dp"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/weatherIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                android:includeFontPadding="false"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/weatherValue"
                        style="@style/WidgetValue"
                        android:layout_marginTop="0dp" />

                    <TextView
                        android:id="@+id/weatherFeels"
                        style="@style/WidgetSub"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="0dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weatherSub"
                    style="@style/WidgetSub"
                    android:layout_marginTop="1dp"
                    android:textSize="7.5sp" />
            </LinearLayout>
        </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="300dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="240dp" />

    <!-- AI spend, kept deliberately tiny in the corner. -->
    <TextView
        android:id="@+id/aiMini"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/chip"
        android:fontFeatureSettings="tnum"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:textColor="@color/muted"
        android:textSize="8sp"
        android:visibility="gone" />

    <!-- Side panel, drawn over everything; opens when focus moves into it. -->
    <local.nightcap.NavRail
        android:id="@+id/navRail"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
