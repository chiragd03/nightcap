<?xml version="1.0" encoding="utf-8"?>
<!-- A title's page (or an actor's): backdrop and info on top, then seasons, cast and similar titles. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:clipChildren="false">

    <!-- Backdrop of the focused title; its trailer fades in over it after a short rest. -->
    <FrameLayout
        android:layout_width="670dp"
        android:layout_height="377dp"
        android:layout_gravity="top|end">

        <ImageView
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextureView
            android:id="@+id/trailer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_left" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_bottom" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="460dp"
        android:layout_height="236dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="48dp"
        android:orientation="vertical">
        <!-- Fixed box between the clock and the rows: text starts under the clock and is
             clipped at the box edge, so it can never reach the rows. -->

        <TextView
            android:id="@+id/eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontVariationSettings="'wght' 700"
            android:letterSpacing="0.16"
            android:textAllCaps="true"
            android:textColor="@color/lamp"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/big_shoulders"
            android:fontVariationSettings="'wght' 800"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.9"
            android:maxLines="2"
            android:textAllCaps="true"
            android:textSize="50sp" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="2"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="300dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="240dp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Side menu, as on Home: Left on a row's first card opens it. -->
    <local.nightcap.NavRail
        android:id="@+id/navRail"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
