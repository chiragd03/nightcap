<?xml version="1.0" encoding="utf-8"?>
<!-- A Live TV tile that isn't a channel: a row's Browse all (six of its logos, dimmed, behind how
     many it has), a kind in More to explore (its name on a tint of its own), or Search all channels.
     The same size and focus as a channel's tile (card_channel.xml), so rows line up. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/channel"
    android:layout_width="168dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="13dp"
    android:clipChildren="false"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/channelTile"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:background="@drawable/channel_card_bg"
        android:duplicateParentState="true">

        <View
            android:id="@+id/moreTint"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <GridLayout
            android:id="@+id/moreMosaic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.3"
            android:columnCount="3"
            android:padding="6dp"
            android:rowCount="2">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="3dp"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="3dp"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="3dp"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="3dp"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="3dp"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:scaleType="fitCenter" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="3dp"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:scaleType="fitCenter" />
        </GridLayout>

        <!-- Darker towards the middle, so the count or name reads over the logos. -->
        <View
            android:id="@+id/moreShade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/live_more_shade" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/moreIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginBottom="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                android:visibility="gone" />

            <TextView
                android:id="@+id/moreBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/big_shoulders"
                android:fontVariationSettings="'wght' 800"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:shadowColor="#99000000"
                android:shadowRadius="8"
                android:textAllCaps="true"
                android:textColor="@color/text"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/moreSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontVariationSettings="'wght' 700"
                android:letterSpacing="0.16"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="#C3CAD8"
                android:textSize="7.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/moreGo"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:alpha="0.7"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron" />

        <View
            android:id="@+id/sheen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/channel_sheen" />
    </FrameLayout>

    <TextView
        android:id="@+id/channelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:fontVariationSettings="'wght' 600"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/channelSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#647087"
        android:textSize="8.5sp" />
</LinearLayout>
