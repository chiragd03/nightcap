<?xml version="1.0" encoding="utf-8"?>
<!-- Asking for the admin PIN before an admin action (or for a new one, typed twice, when none is
     set): the admin profile, why, the PIN, and Unlock or Cancel, on the same frosted glass as Play on TV's question (see AdminPin.kt). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/sheet_tint"
    android:elevation="16dp">

    <local.nightcap.GlassImageView
        android:id="@+id/pinGlass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/sheet_tint"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- The admin profile. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp">

                <View
                    android:id="@+id/pinDisc"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/profile_disc" />

                <ImageView
                    android:id="@+id/pinAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="3dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/pinWho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontVariationSettings="'wght' 600"
                android:textColor="@color/text"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pinTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/big_shoulders"
            android:fontVariationSettings="'wght' 700"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:text="Admin PIN"
            android:textColor="@color/text"
            android:textSize="25sp" />

        <!-- Why it's asked, or what went wrong. -->
        <TextView
            android:id="@+id/pinDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="10sp" />

        <EditText
            android:id="@+id/pinField"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bar_bg"
            android:gravity="center"
            android:hint="PIN"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:letterSpacing="0.3"
            android:maxLength="8"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/pinChoices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
