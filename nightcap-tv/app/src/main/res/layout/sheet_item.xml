<?xml version="1.0" encoding="utf-8"?>
<!-- One action in a long-press menu: thin line icon and label, dark on the white focus pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:layout_marginTop="2dp"
    android:background="@drawable/nav_item_bg"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <ImageView
        android:id="@+id/sheetIcon"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:tint="@color/nav_item_fg" />

    <TextView
        android:id="@+id/sheetLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:fontVariationSettings="'wght' 500"
        android:maxLines="1"
        android:textColor="@color/nav_item_fg"
        android:textSize="11sp" />
</LinearLayout>
