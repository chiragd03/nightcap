# Copy to .env and fill in. Never commit .env. Every setting is described in nightcap/config.py.
TMDB_API_KEY=
DATABASE_URL=postgresql://user:password@host:5432/marquee
# Encrypts each account's add-on addresses and AI key in the database.
SECRETS_KEY=
PORT=7171
# home (on a home network: TVs find it, joining needs no code) or cloud (the default: on the
# internet, joining takes a household's join code, serve it over https).
MODE=home
# The server owner's key (creates households, picks their admins). Long and random, e.g.
# from: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OWNER_KEY=
# Your own AIOStreams' address, if this server has one.
OWN_AIOSTREAMS_URL=
# The plugins running next to this server, as host:port pairs, comma-separated (my-addon:8080).
PLUGIN_URLS=
# Optional: AI_MODEL, MIN_REBUILD_HOURS, MAX_AGE_HOURS, DEFAULT_COUNTRY, TZ, CACHE_ENTRIES,
# LOOKUP_BUDGET_S. (Nothing runs in the background: the apps ask for refreshes.)
